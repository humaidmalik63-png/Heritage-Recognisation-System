# ==============================================================================
# Visual Heritage Recognition & Grounded Cultural Discovery Platform
# Production Environment Variable Template
# ==============================================================================

# 1. Tier-2 Multimodal Vision-Language Model (Google Gemini)
# Obtain free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# 2. Server & Networking Configuration
HOST=0.0.0.0
PORT=8000

# 3. Security & CORS Configuration
# Comma-separated list of allowed origins (e.g. your Vercel frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://heritage-platform.vercel.app

# 4. Administrative & Curator Authentication Secret
# Protects POST /api/exceptions/{id}/resolve
CURATOR_API_KEY=sih2025_curator_secure_key_here

# 5. Experimental Policy D Shadow Staging Kill-Switch (Default: DISABLED)
ENABLE_SHADOW_CANDIDATE_POLICY_D=DISABLED

