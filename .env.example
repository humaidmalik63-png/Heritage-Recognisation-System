# ==============================================================================
# Visual Heritage Recognition & Grounded Cultural Discovery Platform
# Environment Variable Template
# ==============================================================================
# Copy this file to `.env` (project root or backend/) and fill in real values.
# NEVER commit a filled-in `.env` file. `.gitignore` already covers `.env`.
#
# How the backend loads these: backend/main.py reads the process environment
# (and a local `.env` if python-dotenv is installed). On Railway/Vercel, set
# them in the hosting dashboard instead of uploading a `.env` file.

# 1. Tier-2 Multimodal Vision-Language Model (Google Gemini)
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/apikey
# The backend reads GEMINI_API_KEY first and falls back to GOOGLE_API_KEY.
# Without a key, Tier-2 adjudication is unavailable and the pipeline falls
# back to Tier-1-only decisions (see FIXES_APPLIED.md).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# 2. Admin token — REQUIRED to use the Exceptions drawer / telemetry
# Protects: GET /api/exceptions, POST /api/exceptions/{id}/resolve,
# GET /api/telemetry/gemini. The frontend sends it as
# `Authorization: Bearer <token>` (entered in the drawer, held in memory
# only, never saved). There is NO default: with no token configured, the
# admin endpoints reject every request (fail-closed).
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Legacy alias: CURATOR_API_KEY is still accepted if ADMIN_TOKEN is unset.
# Prefer ADMIN_TOKEN; do not set both to different values.
# CURATOR_API_KEY=

# 3. Deployment environment
# Set ENV=production on the deployed backend. In production the API docs
# (/docs, /redoc, /openapi.json) are disabled. Any other value (or unset)
# leaves docs enabled for local development.
ENV=development

# 4. Server & Networking Configuration
# Local dev: the frontend's .env.development expects the backend on 8001.
# The Dockerfile sets PORT=8000 for container runs; Railway injects its own
# PORT at deploy time. Run locally with: uvicorn backend.main:app --port 8001
HOST=0.0.0.0
PORT=8001

# 5. CORS Configuration
# Comma-separated list of allowed frontend origins. When unset, the backend
# allows all origins (development default) — set this explicitly in
# production to your frontend URL(s) only.
CORS_ORIGINS=http://localhost:5173,https://heritage-monuments.vercel.app

# 6. Experimental Policy D Shadow Staging Kill-Switch (Default: DISABLED)
ENABLE_SHADOW_CANDIDATE_POLICY_D=DISABLED
