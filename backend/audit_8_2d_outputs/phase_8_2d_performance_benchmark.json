    "reconciliation_findings": [
      {
        "factor": "Unconditional vs Conditional Local Feature Extraction",
        "explanation": "Phase 8.1 unconditionally executed multi-scale SIFT extraction, FLANN matching, and 4-quadrant Local CLIP region re-embedding on 100% of queries regardless of separation. SIFT alone takes ~200-350 ms on CPU, and Local CLIP region crops take ~350-500 ms, summing to 909 ms. In Phase 8.2 and Phase 8.2D, conditional gating invokes local features only on ambiguous queries, while unambiguous queries exit via the fast-path in ~120-170 ms."
      },
      {
        "factor": "CPU vs GPU Hardware Disparity",
        "explanation": "On CPU execution, CLIP ViT-B/32 image encoding takes ~110-150 ms per forward pass. FAISS IndexFlatIP takes <0.1 ms for 210 vectors. With local crop passes on CPU, latency multiplies linearly with the number of bounding boxes. GPU execution drops this to <25 ms."
      },
      {
        "factor": "Warm-up vs Cold-Start Overhead",
        "explanation": "Cold start includes PyTorch/Transformers graph instantiation and memory allocation (~800 ms). Post warm-up, steady-state global CLIP retrieval stabilizes at ~125 ms on modern x86_64 CPUs."
      }
    ]
  }
